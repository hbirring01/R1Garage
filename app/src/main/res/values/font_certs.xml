<?xml version="1.0" encoding="utf-8"?>
<!--
    Certificates for the com.google.android.gms downloadable fonts provider.

    These two arrays ship with Google Play Services and authorize Compose's
    GoogleFont.Provider to fetch fonts (e.g. Inter) at runtime via the
    androidx.compose.ui:ui-text-google-fonts module.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>
            
        </item>
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item>
            
        </item>
    </string-array>
</resources>
